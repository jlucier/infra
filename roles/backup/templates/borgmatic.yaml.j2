# {{ item.name }}. Managed by ansible (roles/backup). Do not edit on the host.

source_directories:
    - {{ item.source }}

repositories:
{% for repo in item.repositories %}
    - path: "{{ repo.path }}"
      label: {{ repo.label }}
      encryption: repokey-blake2
{% endfor %}

encryption_passphrase: "{credential file {{ borgmatic_passphrase_file }}}"

local_path: /usr/local/bin/borg
ssh_command: "{{ borgmatic_ssh_command }}"

# borgmatic derives match_archives from this prefix, so prune and check act only
# on archives named with it. The older auto-* archives stay untouched.
archive_name_format: "{{ borgmatic_archive_prefix }}-{now:%Y-%m-%dT%H:%M:%S}"

compression: zstd
exclude_caches: true
{% if item.exclude is defined %}

exclude_patterns:
{% for pattern in item.exclude %}
    - {{ pattern }}
{% endfor %}
{% endif %}

keep_daily: {{ borgmatic_keep_daily }}
keep_weekly: {{ borgmatic_keep_weekly }}
keep_monthly: {{ borgmatic_keep_monthly }}

retries: {{ borgmatic_retries }}
retry_wait: {{ borgmatic_retry_wait }}

# Back up a ZFS snapshot, so the archive is one point in time. borgmatic finds
# the dataset from source_directories, mounts a snapshot, backs it up, then
# destroys the snapshot, even when the backup fails.
zfs: {}

# Verify that the repos and the archives in them are still readable.
checks:
    - name: repository
      frequency: 2 weeks
    - name: archives
      frequency: 1 month

log_file: {{ borgmatic_log_file }}
{% if item.postgresql_databases is defined %}

# Dump the databases. A ZFS snapshot of a live Postgres is crash-consistent, not
# application-consistent. The dump streams straight into borg, so there is no
# staging file.
#
# pg_dump runs inside the container, because the host has no postgres client.
# Do not switch to borgmatic's `container:` option: it still calls a pg_dump on
# the host. The postgres image trusts local socket connections, so these
# commands need no password.
postgresql_databases:
{% for db in item.postgresql_databases %}
    - name: {{ db.name }}
      username: {{ db.username }}
      format: custom
      pg_dump_command: docker exec -i {{ db.container }} pg_dump
      pg_restore_command: docker exec -i {{ db.container }} pg_restore
      psql_command: docker exec -i {{ db.container }} psql
{% endfor %}
{% endif %}
{% if item.sqlite_databases is defined %}

sqlite_databases:
{% for db in item.sqlite_databases %}
    - name: {{ db.name }}
      path: {{ db.path }}
{% endfor %}
{% endif %}

{% if item.postgresql_databases is defined or item.sqlite_databases is defined %}

commands:
    # The database hooks turn on borg's --read-special. borg then reads a fifo or
    # a socket instead of recording it, and blocks forever on the first one, with
    # no output, no error, no timeout, and the ZFS snapshot left mounted. A
    # container under {{ item.source }} can create one on any night, so fail here
    # instead.
    #
    # borgmatic retries the whole backup when a command fails. Add a command here
    # only when it is necessary.
    - before: action
      when:
          - create
      run:
          - |-
            special=$(find {{ item.source }} -xdev \( -type s -o -type p \) -print -quit)
            if [ -n "$special" ]; then
                echo "borgmatic: $special would hang borg --read-special; exclude it or drop the database hooks" >&2
                exit 1
            fi
{% endif %}
