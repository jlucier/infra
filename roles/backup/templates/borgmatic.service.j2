[Unit]
Description=borgmatic backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Give the backup a low priority. The services on this host come first.
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# A non-zero exit is a real failure. It sends cron mail.
ExecStart={{ borgmatic_bin }} --verbosity -1 --syslog-verbosity 1
