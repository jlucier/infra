# Managed by Ansible, roles/pihole_records.
# Split-horizon DNS for the home LAN. Every Pi-hole instance gets the same
# records. If the records differ, a client gets a different answer from each
# resolver. A change here needs an FTL restart, not a reloaddns. See the
# handler in the role.

# Every service behind Traefik is under *.{{ dns_name }} and resolves to homeboi.
# Keep this wildcard on that label. A wildcard on the apex also matches
# {{ vpn_dns_name }} itself and breaks the VPN. See below.
address=/{{ dns_name }}/{{ homeboi_ip }}

# The apex is the WireGuard endpoint hostname. On the internet it resolves to
# the WAN address. On the LAN it points at the gateway, so the tunnel comes up
# without NAT hairpin. This record must be an exact host-record. An
# address=/.../ wildcard on the apex would swallow every subdomain above.
host-record={{ vpn_dns_name }},{{ gateway_ip }}
